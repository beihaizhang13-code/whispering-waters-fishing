# ============================================================================
# 《微风垂钓物语 2.0》环境变量模板 (.env.example)
# 复制为 .env 后在本地修改，严禁将包含真实密钥的 .env 提交到版本库
# 线上 Netlify 环境变量与 Secrets 请在 Netlify Dashboard / CLI 中配置
# ============================================================================

# --- 运行环境与服务端口 ---
NODE_ENV=development
APP_ENV=local
PORT=18888
HOST=127.0.0.1

# --- 存储驱动与数据库 ---
# 本地零依赖联调使用 sqlite；线上 Netlify 生产环境设为 postgres
STORAGE_DRIVER=sqlite
SQLITE_DB_PATH=./data/whispering_waters.sqlite
# 线上由 @netlify/database 自动注入，或在连接外部 Postgres 时配置
NETLIFY_DB_URL=

# --- 会话、游客令牌与跨域配置 ---
# 本地开发请生成随机 32+ 字节字符串；线上务必放入 Netlify Secrets
AUTH_SESSION_SECRET=replace-with-local-dev-session-secret-min-32-chars
AUTH_GUEST_TOKEN_SECRET=replace-with-local-dev-guest-secret-min-32-chars
SESSION_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:18888,http://127.0.0.1:18888

# --- 第三方 OAuth 客户端 ID (对应 Secret 仅存放在 Netlify Secrets，绝不写入前端或仓库) ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GITHUB_CLIENT_ID=

# --- 限流与安全防线 ---
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQ=120

# --- 游戏全服世界与离线收益规则 ---
WORLD_CLOCK_SEED=wwf-v2-global
OFFLINE_AQUARIUM_MAX_HOURS=24

# --- 功能特性开关 (M0 基座阶段默认关闭云端主动同步，保持单机即玩) ---
FEATURE_CLOUD_SYNC=false
FEATURE_LEADERBOARDS=false
FEATURE_SOCIAL_SHARES=false
