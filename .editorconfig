# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{html,css}]
indent_style = space
indent_size = 4

[js/**/*.js]
indent_style = space
indent_size = 4

[{shared,backend,scripts,tests,netlify,db}/**/*.{js,mjs,sql}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml,toml,md,webmanifest}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
